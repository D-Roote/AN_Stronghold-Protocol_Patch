# Copy to service/.env and set privately; never commit the token.
TUNNEL_TOKEN=

# Other paths, versioned image, and KR build settings are generated by configure.

# Optional nginx gateway settings (stack.nginx.yaml only).
NGINX_BIND_IP=0.0.0.0
NGINX_HTTP_PORT=80

# Managed Let's Encrypt HTTPS: run scripts/tls.py configure, then issue.
# TLS_DOMAIN, TLS_EMAIL, TLS_CA, TLS_STATE_DIR and local UID/GID are generated.
NGINX_HTTPS_PORT=443
# Optional image override; Alpine-based, supports amd64 and arm64.
# TLS_ACME_IMAGE=ghcr.io/acmesh-official/acme.sh:3.1.6

# Independent asset-only nginx (setup --asset-server or assets-export).
# ASSET_BUNDLE_DIR is set to the complete exported bundle by the script.
ASSET_BIND_IP=0.0.0.0
ASSET_HTTP_PORT=8081
# Empty for /assets, /fonts, /media, /healthz/assets; e.g. /stronghold is also supported.
ASSET_PUBLIC_PATH=

# Manual TLS override: stack.assets-direct.yaml + stack.assets-https.yaml.
# For automatic issuance/renewal use stack.assets-acme.yaml instead.
ASSET_HTTPS_PORT=443
ASSET_TLS_CERT=
ASSET_TLS_KEY=
